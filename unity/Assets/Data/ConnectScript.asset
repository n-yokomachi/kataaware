  - id: jack
    label: "\u30B1\u30FC\u30D6\u30EB\u3092\u7E4B\u3050"
    lines:
    - "\u624B\u9996\u306E\u30B8\u30E3\u30C3\u30AF\u306B\u30B1\u30FC\u30D6\u30EB\u3092\u633F\u3059\u3002\u51B7\u305F\u3044\u611F\u89E6\u304C\u76AE\u819A\u306E\u4E0B\u306B\u4FB5\u5165\u3057\u3066\u304F\u308B"
