  - id: garage.door
    label: "\u8ECA\u306B\u4E57\u308A\u8FBC\u3080"
    lines:
    - "\u30DC\u30ED\u306E\u30AA\u30D5\u30ED\u30FC\u30C9\u8ECA\u3002\u30C9\u30A2\u306E\u7ACB\u3066\u4ED8\u3051\u306F\u76F8\u5909\u308F\u3089\u305A\u60AA\u3044"
    hints: []
