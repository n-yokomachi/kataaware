      afterYes: []
  - id: drive.band1
    label: 
    lines:
    - "\u601D\u3048\u3070\u3053\u306E\u6642\u306E\u305F\u3081\u306B\u3001\u79C1\u306F\u5E7E\u4EBA\u3082\u306E\u601D\u3044\u51FA\u3092\u76D7\u307F\u898B\u3066\u304D\u305F"
    - "\u8AB0\u304B\u306E\u8A18\u61B6\u306E\u4E2D\u306B\u79C1\u304C\u3044\u308C\u3070\u3001\u304D\u3063\u3068\u305D\u306E\u4EBA\u306F\u79C1\u306E\u3053\u3068\u3092\u77E5\u3063\u3066\u3044\u308B"
