  entries:
  - id: jack
    label: "\u30B1\u30FC\u30D6\u30EB\u3092\u629C\u304F"
    lines:
    - "\u624B\u9996\u306E\u30A4\u30F3\u30D7\u30E9\u30F3\u30C8\u30B8\u30E3\u30C3\u30AF\u304B\u3089\u30CA\u30FC\u30F4\u30FB\u30BF\u30FC\u30DF\u30CA\u30EB\u306E\u5916\u90E8\u30B9\u30C8\u30EC\u30FC\u30B8\u30B1\u30FC\u30D6\u30EB\u3092\u5F15\u304D\u629C\u304F\u3068\u540C\u6642\u306B\u3001\n\u8EAB\u4F53<\u304B\u3089\u3060>\u306B\u7C60\u3063\u3066\u3044\u305F\u71B1\u304C\u629C\u3051\u3066\u3044\u304F\u3088\u3046\u306B\u611F\u3058\u3066\u5FC3\u5730\u3088\u3044\u3002"
    - "\u6DF1\u304F\u547C\u5438\u3092\u7E70\u308A\u8FD4\u3059\u3046\u3061\u306B\u3088\u3046\u3084\u304F\u4E94\u611F\u304C\u81EA\u5206\u306E\u8EAB\u4F53\u306B\u623B\u3063\u3066\u304F\u308B\u3002\n\u307C\u3084\u3051\u3066\u3044\u305F\u8996\u754C\u3082\u3088\u3046\u3084\u304F\u305D\u306E\u30D4\u30F3\u30C8\u304C\u5408\u3063\u3066\u304D\u305F\u3002"
    - "<dot>\u4ED6\u4EBA\u306E\u8A18\u61B6\u306B\u6F5C\u3063\u305F\u5F8C</dot>\u306F\u5927\u5C0F\u306E\u5DEE\u3053\u305D\u3042\u308C\u3044\u3064\u3082\u3053\u3046\u9154\u3063\u3066\u3057\u307E\u3046\u3002\n\u81EA\u5206\u3068\u8EAB\u4F53\u611F\u899A\u306E\u9055\u3046\u4ED6\u4EBA\u306B\u6191\u4F9D\u3057\u3066\u3044\u305F\u3088\u3046\u306A\u3082\u306E\u3060\u304B\u3089\u5F53\u7136\u3060\u3002"
    hints: []
    choice:
      question: 
      afterYes: []
  - id: cigarette
    label: "\u7159\u8349\u3092\u53D6\u308B"
    lines:
    - "\u7159\u8349\u3092\u624B\u306B\u53D6\u308A\u3001\u3044\u3064\u304B2\u30C9\u30EB\u3067\u8CB7\u3063\u305F\u30DC\u30ED\u30DC\u30ED\u306E\u30B8\u30C3\u30DD\u3067\u706B\u3092\u70B9\u3051\u308B\u3002"
    hints: []
    choice:
      question: 
      afterYes: []
  - id: jacket
    label: "\u30B8\u30E3\u30B1\u30C3\u30C8\u3092\u7740\u308B"
    lines: []
    hints: []
    choice:
      question: 
      afterYes: []
  - id: chips
    label: "\u30E1\u30E2\u30EA\u30CF\u30D6"
    lines:
    - "\u30E1\u30E2\u30EA\u30CF\u30D6\u306B\u306F\u3001\u4ECA\u65E5\u56DE\u53CE\u3057\u3066\u66F8\u304D\u8FBC\u307F\u6E08\u307F\u306E\u30E1\u30E2\u30EA<\u8A18\u61B6>\u30C1\u30C3\u30D7\u304C6\u679A\u5206\u633F\u3057\u3066\u3042\u308B\u3002"
    - "\u200B08/15  #1  Male    41  32m40s  \u300EDiego\u300F\n08/15  #2  Female 
      23  16m05s  \u300EMia\u300F\n08/15  #3  Male     8  24m38s  \u300E\u512A\u6597\u300F\n08/15 
      #4  Female  35  56m26s  \u300E\u963F\u660E\u300F\n08/15  #5  Male    19   3m32s 
      \u300ELiam\u300F\n08/15  #6  Female  52  48m55s  \u300EMathilde\u300F"
    hints: []
    choice:
      question: "\u30E1\u30E2\u30EA\u30C1\u30C3\u30D7\u3092\u629C\u304F"
      afterYes: []
  - id: terminal
    label: "\u30E2\u30CB\u30BF\u30FC"
    lines:
    - "\u4E16\u9593\u3067\u306F\u30DB\u30ED\u30B3\u30F3\u30BD\u30FC\u30EB\u304C\u4EBA\u6C17\u3060\u304C\u3001\u79C1\u306F\u3082\u3063\u3071\u3089\u7269\u7406\u30E2\u30CB\u30BF\u30FC\u3092\u597D\u3093\u3067\u4F7F\u3063\u3066\u3044\u308B\u3002\n\u3068\u3044\u3046\u306E\u3082\u307B\u3089\u3001"
    - "\u3053\u3046\u3057\u3066\u753B\u9762\u306E\u53CD\u5C04\u3067\u81EA\u5206\u306E\u9854\u304C\u898B\u3089\u308C\u308B\u304B\u3089\u3060\u3002"
    - "\u9ED2\u3044\u9AEA\u306B\u7425\u73C0\u8272\u306E\u76EE\u3002\u53E3\u5143\u306E\u307B\u304F\u308D\u3002\u9593\u9055\u3044\u306A\u304F\u81EA\u5206\u306E\u9854\u3002\n\u2026\u3044\u3084\u3001\u5225\u306B\u30CA\u30EB\u30B7\u30B9\u30C8\u3068\u3044\u3046\u308F\u3051\u3067\u306F\u306A\u3044\u3002"
    - "\u305F\u3060\u3067\u3055\u3048\u4ED6\u4EBA\u306E\u8A18\u61B6\u306B\u6F5C\u308B\u306E\u306B\u306F\u9154\u3044\u304C\u3064\u304D\u3082\u306E\u306A\u306E\u3060\u304C\u3001\n\u305D\u306E\u30BF\u30FC\u30B2\u30C3\u30C8\u304C\u5F37\u3044\u611F\u899A\u523A\u6FC0\u3092\u53D7\u3051\u3066\u3044\u308B\u6700\u4E2D\u3060\u3063\u305F\u308A\u3059\u308B\u3068\u3001\u79C1\u307E\u3067\u305D\u306E\u5F71\u97FF\u3092\u5F37\u304F\u53D7\u3051\u3066\u3057\u307E\u3046\u3002"
    - "\u85AC\u3067\u30C8\u30EA\u30C3\u30D7\u3057\u3066\u3044\u308B\u8A18\u61B6\u306B\u6F5C\u308A\u8FBC\u3093\u3060\u6642\u306A\u3069\u306F\u6700\u60AA\u306A\u3082\u306E\u3067\u3001\n\u623B\u3063\u3066\u304D\u305F\u3068\u304D\u306B\u306F\u6CE1\u3092\u5439\u3044\u3066\u6C17\u7D76\u3057\u3066\u3044\u305F\u3053\u3068\u3082\u4F55\u5EA6\u304B\u3042\u308B\u3002"
    - "\u3068\u3044\u3046\u308F\u3051\u3067\u3001\u81EA\u5206\u306E\u4F53\u306B\u623B\u3063\u3066\u304D\u305F\u5F8C\u306E\u81EA\u5DF1\u540C\u5B9A\u306E\u305F\u3081\u306B\u3082\u3001\n\u93E1\u3068\u306A\u308B\u3082\u306E\u3092\u901A\u3057\u3066\u81EA\u5206\u306E\u59FF\u3092\u898B\u3066\u81EA\u5206\u306E\u5B58\u5728\u3092\u78BA\u8A8D\u3059\u308B\u3053\u3068\u304C\u5927\u5207\u306A\u306E\u3060\u3002"
    hints: []
    choice:
      question: "\u30B9\u30EA\u30FC\u30D7\u3092\u89E3\u9664\u3059\u308B"
      afterYes:
      - "\u30E2\u30CB\u30BF\u30FC\u306E\u30B9\u30EA\u30FC\u30D7\u3092\u89E3\u9664\u3059\u308B\u3068\u3001\u4ECA\u65E5\u306E\u8A18\u61B6\u8D70\u67FB\u6761\u4EF6\u304C\u8868\u793A\u3055\u308C\u308B"
      - "\u200B\u6761\u4EF6: \u540D\u524D\u3092\u547C\u3070\u308C\u305F\u6642\u523B\n\u5BFE\u8C61:
        \u9632\u58C1\u306A\u3057\n\u8DDD\u96E2: \u30E9\u30F3\u30C0\u30E0\n\u671F\u9593:
        2156/03/02 - 2156/03/03\n\u5019\u88DC\u306E\u7C21\u6613\u62BD\u51FA\u7D50\u679C:
        526,232,318\u4EF6"
  - id: door
    label: "\u30C9\u30A2"
    lines:
    - "\u3055\u3066\u3001\u7159\u8349\u306E\u88DC\u5145\u3064\u3044\u3067\u306B\u4ECA\u65E5\u306E\u30E1\u30E2\u30EA\u30C1\u30C3\u30D7\u3092\u58F2\u308A\u306B\u884C\u3053\u3046\u3002"
    hints: []
    choice:
      question: "\u5BB6\u3092\u51FA\u308B"
      afterYes: []
  - id: ashtray
    label: "\u7070\u76BF"
    lines:
    - "\u7070\u76BF\u306B\u306F\u7D19\u5DFB\u304D\u7159\u8349\u306E\u5438\u3044\u6BBB\u304C\u305F\u307E\u3063\u3066\u3044\u308B\u3002\n\u5438\u3044\u6BBB\u3068\u306F\u3044\u3048\u3001\u96C6\u3081\u308C\u3070\u305D\u308C\u306A\u308A\u306E\u4FA1\u683C\u3067\u58F2\u308C\u308B\u7A0B\u5EA6\u306B\u306F\u9AD8\u7D1A\u54C1\u3060\u3002"
    hints: []
