      afterYes: []
  - id: cigarette-box
    label: "\u7159\u8349\u306E\u7BB1"
    lines:
    - "\u300E\u53CC\u9DB4<\u30B7\u30E5\u30A2\u30F3\u30D5\u30A5>\u300F\u3068\u3044\u3046\u540D\u306E\u4E2D\u56FD\u7523\u7D19\u5DFB\u304D\u7159\u8349\u3002\u306E\u7BB1\u3060\u3051\u3002\u4ECA\u306F\u7A7A\u3063\u307D\u3060\u3002\u304B\u306A\u3057\u3044\u3002"
