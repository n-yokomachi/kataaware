  entries:
  - id: jack
    label: "\u30A4\u30F3\u30D7\u30E9\u30F3\u30C8\u30B8\u30E3\u30C3\u30AF\u3092\u629C\u304F"
    lines:
    - "\u5927\u5C0F\u306E\u5DEE\u3053\u305D\u3042\u308C\u3001\u4ED6\u4EBA\u306E\u8A18\u61B6\u3092\u89B3\u305F\u5F8C\u306F\u3044\u3064\u3082\u3053\u3046\u3060"
    hints: []
  - id: cigarette
    label: "\u7159\u8349\u3092\u53D6\u308B"
